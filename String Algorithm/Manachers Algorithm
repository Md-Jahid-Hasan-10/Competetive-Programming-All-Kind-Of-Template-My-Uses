const ll oo = 1e18;

struct manacher {
    vector<int> p;
    void run_manacher(string s){
        int n = s.size();
        p.assign(n, 0);
        int center = 0, right = 0;
        for(int i = 0; i < n; i++){
            int mirror = 2 * center - i;
            if(i < right){
                p[i] = min(right - i, p[mirror]);
            }
            while(i - p[i] - 1 >= 0 && i + p[i] + 1 < n && 
                   s[i - p[i] - 1] == s[i + p[i] + 1]){
                p[i]++;
            }
            if(i + p[i] > right){
                center = i;
                right = i + p[i];
            }
        }
    }
    void build(string s){
        string t = "#";
        for(char c : s){
            t += c;
            t += "#";
        }
        run_manacher(t);
    }
    int get_longest(int cen, bool odd){
        int pos = 2 * cen + 1;
        if(!odd) pos++;
        return p[pos];
    }
    bool is_palindrome(int l, int r){
        int len = r - l + 1;
        int center_pos = 2 * l + len;
        return p[center_pos] >= len;
    }
};
void Goriber_solve()
{
    string s;
    cin >> s;
    manacher m;
    m.build(s);
    int mx = 0;
    for(int i = 0; i < sz(s); i++){
        int la = m.get_longest(i,0);
        int ra = m.get_longest(i,1);
        mx = max({la,ra,mx});
    }
    for(int i = 0; i < sz(s); i++){
        if(m.is_palindrome(i,i+mx-1)){
            cout << s.substr(i,mx) << endl;
            return;
        }
    }
}
