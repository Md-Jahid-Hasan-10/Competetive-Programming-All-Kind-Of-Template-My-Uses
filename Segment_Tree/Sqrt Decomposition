void Goriber_solve()
{
    int n, q;cin >> n >> q;
    vector<int> a(n);
    for(auto &i : a) cin >> i;
    int len = (int)sqrt(n) + 1;
    int blocks = (n + len - 1) / len;
    vector<int> b(blocks, 0);
    while(q--){
        int t;
        cin >> t;
        if(t == 2){
            int k;
            cin >> k;
            k--;
            int block = k / len;
            cout << a[k] + b[block] << endl;
        }
        else{
            int l, r, v;
            cin >> l >> r >> v;
            l--, r--;
            int left_block = l / len;
            int right_block = r / len;
            if(left_block == right_block) {
                for(int i = l; i <= r; i++) {
                    a[i] += v;
                }
            }
            else {
                int end_left = (left_block + 1) * len - 1;
                for(int i = l; i <= min(r, end_left); i++) {
                    a[i] += v;
                }
                for(int block = left_block + 1; block <= right_block - 1; block++) {
                    b[block] += v;
                }
                int start_right = right_block * len;
                for(int i = max(l, start_right); i <= r; i++) {
                    a[i] += v;
                }
            }
        }
    }
}
