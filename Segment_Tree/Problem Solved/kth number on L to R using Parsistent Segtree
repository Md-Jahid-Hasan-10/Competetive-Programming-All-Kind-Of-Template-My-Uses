int ar[N];
struct Node {
    long long val;Node* lc;Node* rc;
};
vector<Node*> lagbe;
Node* newNode() {
    Node* n = new Node();
    lagbe.push_back(n);
    n->val = 0;n->lc = nullptr;n->rc = nullptr;
    return n;
}
Node* build(int l, int r) {
    Node* me = newNode();
    if(l == r) return me;
    int mid = (l + r) / 2;
    me->lc = build(l, mid);
    me->rc = build(mid + 1, r);
    me->val = me->lc->val + me->rc->val;
    return me;
}
Node* update(Node* my, int l, int r, int ind, int val) {
    if(l == r) {
        Node* new_my = newNode();
        new_my->val = my->val + val;
        return new_my;
    }
    Node* new_me = newNode();
    int mid = (l + r) / 2;
    if(ind <= mid) {
        new_me->lc = update(my->lc, l, mid, ind, val);
        new_me->rc = my->rc;
    } else {
        new_me->lc = my->lc;
        new_me->rc = update(my->rc, mid + 1, r, ind, val);
    }
    new_me->val = new_me->lc->val + new_me->rc->val;
    return new_me;
}
int query(Node* n1, Node* n2, int l, int r, int k) {
    if(l == r){return l;}
    int mid = (l + r) / 2;
    int left = n1->lc->val - n2->lc->val;
    if(k <= left){
        return query(n1->lc, n2->lc, l, mid, k);
    } else {
        return query(n1->rc, n2->rc, mid + 1, r, k - left);
    }
}
Node* versions[N];
vi com;
void Goriber_solve(){
    int n,q; cin >> n >> q;
    for(int i = 1; i <= n; i++){
        cin >> ar[i]; com.pb(ar[i]);
    }
    sort(all(com));
    com.resize(unique(all(com))-com.begin());
    map<int,int> pos; int x = 0;
    for(auto u : com)pos[u] = x++;
    int si = sz(com); versions[0] = build(0,si);
    for(int i = 1; i <= n; i++){
        versions[i] = update(versions[i-1],0,si,pos[ar[i]],1);
    }
    while(q--){
        int l,r,k; cin >> l >> r >> k;
        int x = query(versions[r],versions[l-1],0,si,k);
        cout << com[x] << endl;
    } com.clear();
}
