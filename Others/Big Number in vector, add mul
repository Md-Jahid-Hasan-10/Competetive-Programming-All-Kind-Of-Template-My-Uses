vi fromInt(int x){
    if(x == 0)return {0};
    vi r;
    while(x > 0){
        r.push_back(x % 10);
        x/=10;
    }
    return r;
}

vi add(vi a,vi b){
    vi r;
    int carry = 0,n = max(sz(a),sz(b));
    for(int i = 0;i < n || carry; i++){
        int s = carry;
        if(i < sz(a))s += a[i];
        if(i < sz(b))s += b[i];
        r.push_back(s % 10);
        carry = s/10;
    }
    return r;
}

vi mul(vi a,int b){
    vi r;
    int carry=0;
    for(int i = 0;i < sz(a) || carry; i++){
        int s = carry;
        if(i < sz(a))s += a[i]*b;
        r.push_back(s % 10);
        carry = s/10;
    }
    return r;
}

void print(vi a){
    for(int i = sz(a) - 1; i >= 0; i--){
        cout << a[i];
    }
    cout << endl;
}
