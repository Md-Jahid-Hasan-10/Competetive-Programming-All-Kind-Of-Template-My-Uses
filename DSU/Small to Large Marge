vi graph[N];
unordered_map<int,int> bd[N];
int col[N],ans[N],mx[N];
 
void dfs(int node,int par){
    bd[node][col[node]] = 1;
    mx[node] = 1,ans[node] = col[node];
    for(auto &u : graph[node]){
        if(u == par)continue;
        dfs(u,node);
        if(sz(bd[node]) < sz(bd[u])){
            swap(bd[node],bd[u]);
            mx[node] = mx[u];
            ans[node] = ans[u];
        }
        for(auto &[c, cnt] : bd[u]){
            bd[node][c] += cnt;
            if(bd[node][c] > mx[node]){
                mx[node] = bd[node][c];
                ans[node] = c;
            }
            else if(bd[node][c] == mx[node]){
                ans[node] += c;
            }
        }
        bd[u].clear();
    }
}
